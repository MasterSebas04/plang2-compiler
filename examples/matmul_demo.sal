let A: Matrix<Float> = [[6.0, 6.0, 7.0], [8.0, 8.0, 9.0], [3.0, 4.0, 5.0]]
let B: Matrix<Float> = [[5.0, 6.0, 7.0], [7.0, 8.0, 9.0], [3.0, 4.0, 5.0]]
let vec_1: Vec<Float> = [8.0, 3.0, 6.0]

let C = A @ B
let D = vec_1 @ B

let slice1 = slice C(0)
let index1 = slice slice1(1)

print(C)
print(D)
print(index1)


